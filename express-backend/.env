# Environment variables for IRIS Express Backend
MONGO_URI=mongodb://localhost:27017/iris
JWT_SECRET=iris-super-secret-key-change-in-production
PORT=8000

# ── Email (SMTP) Configuration ────────────────────────
# For Gmail: enable "App Passwords" in your Google account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Frontend URL (for password reset links) ───────────
FRONTEND_URL=http://localhost:5173
